{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Awesome Vibe-Coded SaaS catalog entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "slug",
    "name",
    "status",
    "category",
    "repoUrl",
    "license",
    "openSourceStatus",
    "maintainer",
    "paidAlternatives",
    "sourceDirectory",
    "description",
    "features",
    "limitations",
    "dependencies",
    "vibeCodedEvidence",
    "vibeCodedEvidenceUrl",
    "lastVerified"
  ],
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 2
    },
    "status": {
      "enum": [
        "existing",
        "planned",
        "consolidate"
      ]
    },
    "category": {
      "type": "string",
      "minLength": 2
    },
    "repoUrl": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "demoUrl": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "openSourceStatus": {
      "enum": [
        "open-source",
        "license-needed",
        "planned"
      ]
    },
    "maintainer": {
      "type": "string",
      "minLength": 1
    },
    "paidAlternatives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sourceDirectory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "url",
        "slugs"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "slugs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "description": {
      "type": "string",
      "minLength": 20
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "vibeCodedEvidence": {
      "enum": [
        "author-claimed",
        "maintainer-verified",
        "unverified"
      ]
    },
    "vibeCodedEvidenceUrl": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "notes": {
      "type": "string"
    },
    "lastVerified": {
      "type": "string",
      "format": "date"
    }
  }
}
